# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyo

# Segreti locali (token Telegram, chat id...) — NON vanno mai committati
.env
.env.*
unionscraping/.env
unionscraping/.env.*

# Messaggi generati (rigenerabili con whatsapp_reminder.py)
unionscraping/bot/messaggi/

# Stato e log del bot Telegram
unionscraping/bot/.bot_state.json
unionscraping/bot/bot.log
unionscraping/bot/bot.log.*

# Cache di auto_from_screenshots.py: screenshot scaricati, testo OCR e
# binario dell'helper. Si rigenera da solo con lo script.
unionscraping/auto/.screenshots/

# Cache di classifiche.py: immagini delle classifiche di gara del portale
unionscraping/classifiche/.gare/

# Foglietti di telecronaca generati (rigenerabili con telecronaca.py)
unionscraping/telecronaca/fogli/


# Materiale di lavoro locale (mai nel repo né sul sito)
_locale/

# Telecronaca: strumento personale, solo sul computer di chi commenta
unionscraping/telecronaca/
