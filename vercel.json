{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/telegram.py": {
      "includeFiles": "unionscraping/**",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/sportscraping/sport.json",
      "headers": [
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/unionscraping/data.json",
      "headers": [
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/unionscraping/auto.json",
      "headers": [
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
